# .dockerignore — build context is the REPO ROOT (see backend/Dockerfile).
#
# Only `backend/` is needed to run the gateway (src + prompts + requirements).
# Everything below is kept OUT of the image: it is either large (venvs, VCS),
# regenerable (caches), or must never leak into the image (local env /
# secrets, ТЗ §36: «Secrets не коммитить»). No secret VALUES are written
# here — only file-name patterns that exclude them.

# Version control
.git
.gitignore

# Local environment / secrets — NEVER in the image. Patterns only.
.env
.env.*
*.env
secrets/
*.pem
*.key

# Python virtualenvs + caches (not shipped at runtime)
**/.venv
**/venv
**/__pycache__
*.pyc
*.pyo
**/.pytest_cache
.mypy_cache
.ruff_cache
.coverage
coverage

# Kanban scratch worktrees
.worktrees/
