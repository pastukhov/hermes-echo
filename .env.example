# =========================================================================
# Hermes Voice Terminal — backend configuration (ТЗ §36, §37)
#
# Copy to .env and fill in real values:
#     cp .env.example .env
#
# .env must NEVER be committed (ТЗ §36: «Secrets не коммитить»). The three
# *_API_KEY variables below are secrets: this file carries placeholders /
# empty values only.
#
# The 16 backend variables of ТЗ §36 (ingest/archive/STT/Hermes/TTS/notes),
# plus the auth + rate-limit variables added by ТЗ §40/§34.
# =========================================================================

# --- HTTP bind (ТЗ §36/§37) --------------------------------------------
# Read by the docker-compose launch command (uvicorn --host/--port) and by
# the published port; the application itself does not read these two.
VOICE_BIND_HOST=0.0.0.0
VOICE_BIND_PORT=8080

# --- Voice-turn archive (ТЗ §18, §36) -----------------------------------
# Locally: ./archive. In Docker, docker-compose overrides this to
# /data/archive (named volume `archive_data`) — do not change it for Docker.
ARCHIVE_ROOT=./archive

# --- STT (ТЗ §20) — OpenAI-compatible /audio/transcriptions --------------
# STT_BASE_URL is required — the app refuses a turn without it.
STT_BASE_URL=https://stt.example.com/v1
# (secret) Leave empty if the STT endpoint requires no auth.
STT_API_KEY=
STT_MODEL=stt

# --- Hermes (ТЗ §21) — OpenAI-compatible /chat/completions ---------------
# HERMES_BASE_URL is required.
HERMES_BASE_URL=https://hermes.example.com/v1
# (secret) Leave empty if the endpoint requires no auth.
HERMES_API_KEY=
HERMES_MODEL=hermes

# --- TTS (ТЗ §33) — OpenAI-compatible /audio/speech ----------------------
# Required before the TTS stage is enabled; fill in before using voice reply.
# TTS_BASE_URL is the FULL TTS endpoint URL (no suffix is appended).
TTS_BASE_URL=https://tts.example.com/v1/audio/speech
# (secret) Leave empty if the TTS endpoint requires no auth.
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
TTS_TIMEOUT=60

# --- Obsidian notes (ТЗ §25–27) ------------------------------------------
# Path to the Obsidian vault; notes are written as .md into the
# OBSIDIAN_INBOX subfolder. In Docker, docker-compose overrides this to
# /data/obsidian (named volume `obsidian_data`).
OBSIDIAN_VAULT_PATH=./obsidian
OBSIDIAN_INBOX=Voice Inbox
# true/false — include the STT transcript in the note (ТЗ §27).
NOTE_INCLUDE_TRANSCRIPT=false

# --- Device-token auth + rate limiting (ТЗ §40, §34) ---------------------
# (secret) VOICE_API_KEY — the device token clients present as
# `Authorization: Bearer <token>` (or `X-Device-Token: <token>`).
# Auth is enabled iff this is set, unless VOICE_AUTH_ENABLED overrides.
VOICE_API_KEY=
# Optional explicit switch. Unset: enabled iff VOICE_API_KEY is set.
# "false" is the test-only disable mode. "true" without a key is an error.
#VOICE_AUTH_ENABLED=
# Requests allowed per client/route and per route (across all clients)
# within VOICE_RATE_PERIOD seconds. Defaults: 100 requests / 60 seconds.
#VOICE_RATE_LIMIT=100
#VOICE_RATE_PERIOD=60
