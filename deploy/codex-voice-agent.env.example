# Copy to ~/.config/hermes-echo/codex-voice-agent.env and chmod 600.
# CODEX_AGENT_TOKEN must match the gateway's CODEX_AGENT_TOKEN exactly.
CODEX_AGENT_TOKEN=replace-with-a-random-adapter-token
# Optional exact model identifier; unset means the configured Codex default.
# CODEX_VOICE_MODEL=
CODEX_VOICE_TURN_TIMEOUT=120
